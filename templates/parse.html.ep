% layout 'main';
% title 'Word Parser';

%= include 'partials/_header'

<%= form_for '/parse' => (method => 'get') => begin %>
    <div class="row g-3 align-items-end mb-4">
        <div class="col-md-3">
            <label class="form-label" for="query">Word</label>
            <%= text_field query => stash('query'), placeholder => ' term', autofocus => undef, class => 'form-control' %>
        </div>
        <div class="col-md-2">
            <button type="submit" name="submit" class="btn btn-primary">Parse</button>
        </div>
        <div>
% if (stash('query')) {
            <p></p>
            <a href="https://en.wiktionary.org/wiki/<%= stash('query') %>" target="_blank">https://en.wiktionary.org/wiki/<%= stash('query') %></a>
% }
        </div>
    </div>
<% end %>

% if (length(stash('query') // '')) {
%   my $results = stash('results');
%   if ($results && @$results) {
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Score</th>
                    <th>Partition</th>
                    <th>Definition</th>
                </tr>
            </thead>
            <tbody>
%   for my $row (@$results) {
                <tr>
                    <td>
                        <%= sprintf('%.2f%%', $row->{familiarity}[1] * 100) %> chars<br/>
                        <%= sprintf('%.2f%%', $row->{familiarity}[0] * 100) %> chunks
                    </td>
                    <td>
%     for my $p (@{ $row->{partition} }) {
                        <%== $p %><br />
%     }
                    </td>
                    <td>
%     for my $d (@{ $row->{definition} }) {
                        <a href="/search?type=definition&query=<%= $d %>"><%= $d %></a><br />
%     }
                    </td>
                </tr>
%   }
            </tbody>
        </table>
%   } else {
        <p class="fw-bold">No result</p>
%   }
% }
